      <h2 id="area-title">Local to Sacramento</h2>
      <p>Based in Sacramento and serving homes across the surrounding region.</p>
      <a class="btn btn-primary" href="/service-areas/">See all service areas</a>
    </div>
    <ul class="area-list">
      {%- for a in site.areas %}
      <li{% if loop.first %} class="primary"{% endif %}><a href="/service-areas/#{{ a.id }}">{{ a.name }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="tips-title">
