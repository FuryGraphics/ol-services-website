---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="container container-narrow">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Chimney Tips</a></li>
        <li aria-current="page">Article</li>
      </ol>
    </nav>
    <h1>{{ title }}</h1>
    <p class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ readTime }} read</p>
  </div>
</section>

<div class="section">
  <div class="container container-narrow">
    {% if image %}
    <img class="post-image" src="/images/{{ image }}" width="1600" height="1075" alt="{{ alt }}">
    {% endif %}
    <article class="prose">
      {{ content | safe }}
    </article>

    <div class="post-cta">
      <h2>Have a question about your chimney?</h2>
      <p>Call {{ site.name }} for a free, no-obligation quote.</p>
      <a class="btn btn-primary" href="{{ site.phoneHref }}">{% include "partials/icon-phone.njk" %} {{ site.phone }}</a>
    </div>

    <nav class="post-more" aria-label="More articles">
      <h2>More chimney tips</h2>
      <ul>
        {%- for p in collections.posts %}{% if p.url != page.url %}
        <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
  </div>
</div>
