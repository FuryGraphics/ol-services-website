      </ul>
    </div>

    <figure class="hero-media">
      <img src="/images/hero-roof-inspection.jpg" width="1600" height="1075"
           alt="Technician inspecting a brick chimney on a residential roof at sunset"
           fetchpriority="high">
      <figcaption class="hero-badge">
        <strong>Inspect first.</strong> Quote before any work begins.
      </figcaption>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Services</p>
      <h2 id="services-title">Everything from the firebox to the chimney cap</h2>
      <p>One local crew for your chimney, fireplace, stove and home ventilation.</p>
    </header>

    <div class="card-grid">
      {%- for s in site.services %}
      <a class="link-card" href="{{ s.url }}">
        <img src="/images/{{ s.image }}" width="1600" height="1075" alt="" loading="lazy">
        <div class="link-card-body">
          <h3>{{ s.title }}</h3>
          <p>{{ s.summary }}</p>
