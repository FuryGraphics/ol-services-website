{%- set here = page.url -%}
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="{{ site.name }} home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M6 30V14l10-8 10 8v16z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
        <path d="M20 9V3h4v9.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
        <path d="M16 27c-2.6 0-4-1.8-4-3.8 0-2.6 2.6-3.6 3-6.2 2 1.4 5 3.6 5 6.2 0 2-1.4 3.8-4 3.8z" fill="var(--amber)"/>
      </svg>
      <span class="brand-text">{{ site.name }}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul class="nav-list">
        <li class="nav-item has-sub">
          <a href="/services/" {% if here.startsWith("/services/") %}aria-current="page"{% endif %}>Services</a>
          <button class="sub-toggle" type="button" aria-expanded="false" aria-label="Show services">
            <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </button>
          <ul class="sub-menu">
            {%- for s in site.services %}
            <li><a href="{{ s.url }}" {% if here == s.url %}aria-current="page"{% endif %}>{{ s.title }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        <li class="nav-item"><a href="/service-areas/" {% if here == "/service-areas/" %}aria-current="page"{% endif %}>Service Areas</a></li>
        <li class="nav-item"><a href="/about/" {% if here == "/about/" %}aria-current="page"{% endif %}>About</a></li>
        <li class="nav-item"><a href="/blog/" {% if here.startsWith("/blog/") %}aria-current="page"{% endif %}>Chimney Tips</a></li>
        <li class="nav-item"><a href="/faq/" {% if here == "/faq/" %}aria-current="page"{% endif %}>FAQ</a></li>
        <li class="nav-item"><a href="/contact/" {% if here == "/contact/" %}aria-current="page"{% endif %}>Contact</a></li>
      </ul>
      <a class="btn btn-primary nav-call" href="{{ site.phoneHref }}">
        {% include "partials/icon-phone.njk" %}
        {{ site.phone }}
      </a>
    </nav>
  </div>
</header>
